# ─────────────────────────────────────────────────────────────────────────────
# GF Performance Dashboard — Environment Variables
# Copy this file to .env and fill in your Supabase project values.
# NEVER commit .env to git (already in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (get from: app.supabase.com → Project → Settings → API) ─────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...anon-key...

# ── Server-side only — seed script + Edge Functions (NEVER expose in frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...service-role-key...
SUPABASE_URL=https://your-project-ref.supabase.co

# ── App config ────────────────────────────────────────────────────────────────
VITE_APP_NAME="GF Performance Dashboard"
VITE_FISCAL_YEAR=2026
VITE_MAX_FILE_SIZE_MB=10

# ── Existing integrations ─────────────────────────────────────────────────────
VITE_OPENAI_API_KEY=sk-replace-with-your-openai-api-key
VITE_NOTION_TOKEN=secret_replace-with-your-notion-token
